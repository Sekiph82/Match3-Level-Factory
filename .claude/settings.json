{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git fetch origin *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin main)",
      "Bash(python -m unittest *)",
      "Bash(py -3.12 -m unittest *)",
      "Bash(python -m pytest *)",
      "Bash(py -3.12 -m pytest *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git fetch origin *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push origin main)",
      "PowerShell(py -3.12 -m unittest *)",
      "PowerShell(python -m unittest *)"
    ],
    "ask": [
      "Bash(git tag *)",
      "Bash(gh release *)",
      "Bash(gh api *)",
      "Bash(gh auth *)",
      "PowerShell(git tag *)",
      "PowerShell(gh release *)",
      "PowerShell(gh api *)",
      "PowerShell(gh auth *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git add -A)",
      "Bash(git add .)",
      "Bash(gh workflow *)",
      "Bash(gh run *)",
      "Bash(adb *)",
      "Bash(emulator *)",
      "Bash(rm -rf *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git add -A)",
      "PowerShell(git add .)",
      "PowerShell(gh workflow *)",
      "PowerShell(gh run *)",
      "PowerShell(adb *)",
      "PowerShell(emulator *)",
      "PowerShell(Remove-Item -Recurse *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./**/secrets/**)"
    ]
  }
}
